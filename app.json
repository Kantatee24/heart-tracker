{
  "expo": {
    "name": "HeartLink",
    "slug": "heart-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.heartlink.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HeartLink ต้องการตำแหน่งของคุณเพื่อแชร์กับเพื่อนแบบ real-time",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HeartLink ต้องการตำแหน่งเพื่อ tracking real-time",
        "NSCameraUsageDescription": "HeartLink ต้องการกล้องเพื่อถ่ายรูปเช็คอินและ video call",
        "NSMicrophoneUsageDescription": "HeartLink ต้องการไมค์เพื่อ video call"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.heartlink.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HeartLink ต้องการตำแหน่งเพื่อแชร์ให้เพื่อน"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF2D78"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "HeartLink needs camera access for photo check-ins"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "7f95cc66-a7f9-4a9f-9ec4-53d88d7002ce"
      }
    }
  }
}
